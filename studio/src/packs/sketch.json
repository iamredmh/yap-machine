{
  "id": "sketch",
  "name": "Sketch",
  "description": "A hand-drawn whiteboard style: Caveat headlines and Virgil text on a paper grid, a yellow marker highlight on the word that matters, cards with hand-drawn borders and tape, hand-drawn icons, the camera taped to the page under a torn edge, and lines that arrive like drawn animation.",
  "fonts": [
    { "family": "Caveat", "file": "fonts/sketch/Caveat-400.woff2", "weight": "400" },
    { "family": "Caveat", "file": "fonts/sketch/Caveat-700.woff2", "weight": "700" },
    { "family": "Virgil", "file": "fonts/sketch/Virgil-Regular.woff2", "weight": "400" },
    { "family": "JetBrains Mono", "file": "fonts/shared/JetBrainsMono-400.woff2", "weight": "400" },
    { "family": "JetBrains Mono", "file": "fonts/shared/JetBrainsMono-700.woff2", "weight": "700" }
  ],
  "type": {
    "display": { "family": "Caveat", "fallback": "cursive", "weight": 700, "style": "normal", "tracking": 0, "case": "none", "metrics": "caveat-700", "layout": { "match": "cap", "fit": "cap", "fitScale": 1.3, "measure": 1, "lineHeight": 1.28 } },
    "accent": { "family": "Caveat", "fallback": "cursive", "weight": 400, "style": "normal", "tracking": 0, "case": "none", "metrics": "caveat-400", "layout": { "match": "x", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } },
    "body": { "family": "Virgil", "fallback": "cursive", "weight": 400, "style": "normal", "tracking": 0, "case": "none", "metrics": "virgil", "layout": { "match": "x", "fit": "width", "fitScale": 1, "measure": 34, "lineHeight": 2.7 } },
    "label": { "family": "Virgil", "fallback": "cursive", "weight": 400, "style": "normal", "tracking": 0.06, "case": "uppercase", "metrics": "virgil", "layout": { "match": "cap", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } },
    "code": { "family": "JetBrains Mono", "fallback": "monospace", "weight": 400, "style": "normal", "tracking": 0, "case": "none", "metrics": "jetbrains-mono", "layout": { "match": "none", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } }
  },
  "palette": {
    "base": "#22282B",
    "panel": "#2B3236",
    "surface": "#333B40",
    "line": "#46505A",
    "faint": "#6B7680",
    "muted": "#94A0AA",
    "text": "#F5F1E6",
    "textSoft": "#C9C2B0",
    "ink": "#1F2328",
    "inkSoft": "#5A6068",
    "win": "#FFD43B",
    "friction": "#E5484D",
    "extended": { "blue": "#3B82F6", "green": "#22C55E", "pink": "#FF7AB6", "orange": "#FF8A3D" },
    "heroRotation": ["win", "pink", "green", "orange"]
  },
  "grounds": {
    "dark": { "colour": "#22282B", "texture": null, "glows": [], "pattern": null, "vignette": null },
    "light": { "colour": "#FBF7EE", "texture": null, "glows": [], "pattern": null, "vignette": null }
  },
  "backdrops": [{ "kind": "paper", "size": 56, "alpha": 0.1, "lines": "grid", "margin": false, "grain": 0.45 }],
  "signature": { "surface": "sketch", "mark": "highlight", "icons": "sketch", "reveal": "stepped", "chrome": "tape", "edge": "torn", "tilt": -1.2, "rough": 2.6, "boil": 4 },
  "cards": {
    "dark": { "top": "#2B3236", "fill": "#2B3236", "bottom": "#2B3236", "up": "#333B40", "up2": "#3B444A", "radius": 4, "lightCatch": 0, "shadow": { "dx": 0, "dy": 12, "blur": 24, "colour": "#000000", "alpha": 0.3 }, "ring": null },
    "light": { "top": "#FFFFFF", "fill": "#FFFFFF", "bottom": "#FFFFFF", "up": "#F6F1E4", "up2": "#EEE7D6", "radius": 4, "lightCatch": 0, "shadow": { "dx": 0, "dy": 10, "blur": 20, "colour": "#000000", "alpha": 0.08 }, "ring": null }
  },
  "subtitles": {
    "voice": "display",
    "weight": 700,
    "size": 72,
    "case": "none",
    "tracking": 0,
    "colour": { "dark": "#FFFFFF", "light": "#1F2328" },
    "outline": null,
    "shadow": { "dark": "0 3px 14px rgba(0,0,0,0.7)", "light": null },
    "backing": { "kind": "none", "dark": "", "light": "" },
    "key": { "voice": "display", "weight": 700, "style": "normal", "size": 76, "colour": null, "box": null, "mark": "highlight" },
    "enter": "stepped",
    "laneY": 1470,
    "words": [2, 4]
  },
  "composition": { "ground": "light", "align": "left", "margin": 96, "top": 230, "gap": { "eyebrow": 28, "tagline": 18, "object": 74 } },
  "presenter": {
    "layouts": { "full": true, "halfBand": true, "tile": true },
    "openOn": ["halfBand", "full"],
    "halfBand": { "feather": 0, "rule": null },
    "tile": { "radius": 4, "ring": { "width": 12, "colour": "#FFFFFF" }, "shadow": "0 18px 34px rgba(0,0,0,0.22)" },
    "rim": null
  },
  "transitions": {
    "cut": true,
    "ease": { "enabled": false, "dy": 36, "sink": 0.015, "frames": 10 },
    "zoomThrough": { "enabled": false, "frames": 6 },
    "flash": { "enabled": false, "colour": "win", "frames": 2 },
    "wipe": { "enabled": true, "frames": 12 }
  },
  "motion": {
    "reveal": { "bezier": [0.3, 1.25, 0.5, 1], "frames": 14, "stagger": 4 },
    "leave": [0.5, 0, 0.75, 0],
    "glide": [0.6, 0, 0.3, 1],
    "spring": { "w": 0.4, "z": 0.5 },
    "punch": { "amount": 0.08, "frames": 4 },
    "rise": 40
  },
  "pace": {
    "short": { "secondsPerChange": [2.5, 3.5], "punchIns": "stressed-words" },
    "long": { "secondsPerChange": [5, 7] },
    "endHoldMax": 2,
    "wordsPerMinute": [160, 190]
  },
  "scenes": {
    "brings": ["doodle"],
    "avoid": [],
    "beats": {
      "hook": { "use": ["title", "talk:halfBand"] },
      "payoff": { "use": ["doodle", "talk:full"] },
      "item": { "use": ["list"], "in": "wipe" },
      "number": { "use": ["stat"] },
      "point": { "use": ["talk:full"] },
      "proof": { "use": ["quote"], "in": "wipe" },
      "end": { "use": ["doodle", "talk:full"] }
    }
  }
}
