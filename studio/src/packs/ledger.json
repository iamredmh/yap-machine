{
  "id": "ledger",
  "name": "Ledger",
  "description": "A quiet editorial style: EB Garamond headlines set left on warm newsprint, Newsreader text, mono labels, hairline cards, subtitles on a pill, one red accent, slow and exact motion with no overshoot.",
  "fonts": [
    { "family": "EB Garamond", "file": "fonts/ledger/EBGaramond-400.woff2", "weight": "400" },
    { "family": "EB Garamond", "file": "fonts/ledger/EBGaramond-700.woff2", "weight": "700" },
    { "family": "Newsreader", "file": "fonts/ledger/Newsreader-Variable.woff2", "weight": "200 800" },
    { "family": "JetBrains Mono", "file": "fonts/shared/JetBrainsMono-400.woff2", "weight": "400" },
    { "family": "JetBrains Mono", "file": "fonts/shared/JetBrainsMono-700.woff2", "weight": "700" }
  ],
  "type": {
    "display": { "family": "EB Garamond", "fallback": "serif", "weight": 700, "style": "normal", "tracking": -0.01, "case": "none", "metrics": "eb-garamond-700", "layout": { "match": "cap", "fit": "width", "fitScale": 1, "measure": 0.82, "lineHeight": 1.45 } },
    "accent": { "family": "EB Garamond", "fallback": "serif", "weight": 400, "style": "normal", "tracking": 0, "case": "none", "metrics": "eb-garamond-400", "layout": { "match": "x", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } },
    "body": { "family": "Newsreader", "fallback": "serif", "weight": 400, "style": "normal", "tracking": 0, "case": "none", "metrics": "newsreader", "layout": { "match": "x", "fit": "width", "fitScale": 1, "measure": 46, "lineHeight": 3.1 } },
    "label": { "family": "JetBrains Mono", "fallback": "monospace", "weight": 400, "style": "normal", "tracking": 0.12, "case": "uppercase", "metrics": "jetbrains-mono", "layout": { "match": "cap", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } },
    "code": { "family": "JetBrains Mono", "fallback": "monospace", "weight": 400, "style": "normal", "tracking": 0, "case": "none", "metrics": "jetbrains-mono", "layout": { "match": "none", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } }
  },
  "palette": {
    "base": "#121212",
    "panel": "#1A1A1A",
    "surface": "#222222",
    "line": "#3A3A3A",
    "faint": "#6E6E6E",
    "muted": "#9A9A9A",
    "text": "#F2EEE6",
    "textSoft": "#B8B2A6",
    "ink": "#141414",
    "inkSoft": "#6B665E",
    "win": "#D7261E",
    "friction": "#8A8478",
    "extended": { "blue": "#1F4FD8", "ochre": "#B9861A", "green": "#1E7A4C" },
    "heroRotation": ["win", "blue", "ochre", "green"]
  },
  "grounds": {
    "dark": { "colour": "#121212", "texture": null, "glows": [], "pattern": null, "vignette": null },
    "light": {
      "colour": "#F4F1EA",
      "texture": null,
      "glows": [],
      "pattern": { "kind": "dots", "size": 30, "colour": "#141414", "alpha": 0.07 },
      "vignette": "linear-gradient(180deg, rgba(20,20,20,0.05) 0%, transparent 18%, transparent 82%, rgba(20,20,20,0.06) 100%)"
    }
  },
  "cards": {
    "dark": { "top": "#1C1C1C", "fill": "#1C1C1C", "bottom": "#1C1C1C", "up": "#262626", "up2": "#303030", "radius": 4, "lightCatch": 0, "shadow": { "dx": 0, "dy": 2, "blur": 0, "colour": "#000000", "alpha": 0.4 }, "ring": { "width": 1, "colour": "rgba(255,255,255,0.16)" } },
    "light": { "top": "#FFFFFF", "fill": "#FFFFFF", "bottom": "#FFFFFF", "up": "#F1EDE4", "up2": "#E7E1D5", "radius": 4, "lightCatch": 0, "shadow": { "dx": 0, "dy": 3, "blur": 0, "colour": "#141414", "alpha": 0.08 }, "ring": { "width": 1, "colour": "rgba(20,20,20,0.22)" } }
  },
  "subtitles": {
    "voice": "body",
    "weight": 500,
    "size": 44,
    "case": "none",
    "tracking": 0,
    "colour": { "dark": "#F2EEE6", "light": "#141414" },
    "outline": null,
    "shadow": { "dark": null, "light": null },
    "backing": { "kind": "pill", "dark": "rgba(18,18,18,0.82)", "light": "rgba(255,255,255,0.94)" },
    "key": { "voice": "display", "weight": 700, "style": "normal", "size": 50, "colour": "win", "box": null },
    "enter": "rise",
    "laneY": 1480,
    "words": [3, 7]
  },
  "composition": { "ground": "light", "align": "left", "margin": 110, "top": 230, "gap": { "eyebrow": 56, "tagline": 30, "object": 90 } },
  "presenter": {
    "layouts": { "full": true, "halfBand": true, "tile": true },
    "openOn": ["halfBand"],
    "halfBand": { "feather": 0, "rule": { "width": 3, "colour": "ink" } },
    "tile": { "radius": 4, "ring": { "width": 3, "colour": "#141414" }, "shadow": "0 3px 0 rgba(20,20,20,0.12)" },
    "rim": null
  },
  "transitions": {
    "cut": true,
    "ease": { "enabled": true, "dy": 24, "sink": 0.01, "frames": 12 },
    "zoomThrough": { "enabled": false, "frames": 6 },
    "flash": { "enabled": false, "colour": "win", "frames": 2 },
    "wipe": { "enabled": true, "frames": 16 }
  },
  "motion": {
    "reveal": { "bezier": [0.25, 0.1, 0.25, 1], "frames": 24, "stagger": 6 },
    "leave": [0.42, 0, 1, 1],
    "glide": [0.65, 0, 0.35, 1],
    "spring": { "w": 0.28, "z": 0.85 },
    "punch": { "amount": 0.04, "frames": 8 },
    "rise": 24
  },
  "pace": {
    "short": { "secondsPerChange": [3, 4], "punchIns": "payoffs" },
    "long": { "secondsPerChange": [7, 9] },
    "endHoldMax": 3,
    "wordsPerMinute": [150, 180]
  },
  "scenes": {
    "brings": ["chart"],
    "avoid": [],
    "beats": {
      "hook": { "use": ["title", "talk:halfBand"] },
      "payoff": { "use": ["talk:full"] },
      "item": { "use": ["list"], "in": "wipe" },
      "number": { "use": ["chart", "stat"] },
      "point": { "use": ["talk:halfBand", "talk:tile"], "in": "ease" },
      "proof": { "use": ["quote"], "in": "wipe" },
      "end": { "use": ["talk:tile", "talk:halfBand"] }
    }
  }
}
