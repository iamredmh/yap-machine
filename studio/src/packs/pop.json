{
  "id": "pop",
  "name": "Pop",
  "description": "A neo-brutalist sticker style: Archivo Black headlines and Space Grotesk text on lemon yellow with halftone dots, white cards with thick ink borders and hard shadows, leaning a little, the hero word on a hot-pink block, sticker icons, boxed captions, and springy arrivals with word-pop.",
  "fonts": [
    { "family": "Archivo Black", "file": "fonts/pop/ArchivoBlack-Regular.ttf", "weight": "400" },
    { "family": "Space Grotesk", "file": "fonts/pop/SpaceGrotesk-400.woff2", "weight": "400" },
    { "family": "Space Grotesk", "file": "fonts/pop/SpaceGrotesk-700.woff2", "weight": "700" },
    { "family": "JetBrains Mono", "file": "fonts/shared/JetBrainsMono-400.woff2", "weight": "400" }
  ],
  "type": {
    "display": { "family": "Archivo Black", "fallback": "sans-serif", "weight": 400, "style": "normal", "tracking": -0.025, "case": "none", "metrics": "archivo-black", "layout": { "match": "cap", "fit": "cap", "fitScale": 1.05, "measure": 1, "lineHeight": 1.14 } },
    "accent": { "family": "Space Grotesk", "fallback": "sans-serif", "weight": 700, "style": "normal", "tracking": -0.01, "case": "none", "metrics": "space-grotesk-700", "layout": { "match": "x", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } },
    "body": { "family": "Space Grotesk", "fallback": "sans-serif", "weight": 400, "style": "normal", "tracking": -0.01, "case": "none", "metrics": "space-grotesk-400", "layout": { "match": "x", "fit": "width", "fitScale": 1, "measure": 36, "lineHeight": 2.7 } },
    "label": { "family": "Space Grotesk", "fallback": "sans-serif", "weight": 700, "style": "normal", "tracking": 0.08, "case": "uppercase", "metrics": "space-grotesk-700", "layout": { "match": "cap", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } },
    "code": { "family": "JetBrains Mono", "fallback": "monospace", "weight": 400, "style": "normal", "tracking": 0, "case": "none", "metrics": "jetbrains-mono", "layout": { "match": "none", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } }
  },
  "palette": {
    "base": "#141414",
    "panel": "#1E1E1E",
    "surface": "#262626",
    "line": "#3A3A3A",
    "faint": "#6B6B6B",
    "muted": "#9A9A9A",
    "text": "#FFFFFF",
    "textSoft": "#D4D4D4",
    "ink": "#111111",
    "inkSoft": "#3D3D3D",
    "win": "#FF4D8D",
    "friction": "#111111",
    "extended": { "blue": "#2F6BFF", "green": "#00C26E", "orange": "#FF7A1A", "violet": "#8E5CFF" },
    "heroRotation": ["win", "blue", "green", "orange"]
  },
  "grounds": {
    "dark": { "colour": "#141414", "texture": null, "glows": [], "pattern": null, "vignette": null },
    "light": { "colour": "#FFE14D", "texture": null, "glows": [], "pattern": null, "vignette": null }
  },
  "backdrops": [{ "kind": "halftone", "size": 30, "alpha": 0.14, "from": "corner" }],
  "signature": { "surface": "brutal", "mark": "box", "icons": "sticker", "reveal": "rise", "chrome": "none", "edge": "straight", "tilt": -2, "rough": 0, "boil": 0 },
  "cards": {
    "dark": { "top": "#1E1E1E", "fill": "#1E1E1E", "bottom": "#1E1E1E", "up": "#262626", "up2": "#2E2E2E", "radius": 22, "lightCatch": 0, "shadow": { "dx": 0, "dy": 0, "blur": 0, "colour": "#000000", "alpha": 0 }, "ring": null },
    "light": { "top": "#FFFFFF", "fill": "#FFFFFF", "bottom": "#FFFFFF", "up": "#FFF7D1", "up2": "#FFEFA8", "radius": 22, "lightCatch": 0, "shadow": { "dx": 0, "dy": 0, "blur": 0, "colour": "#000000", "alpha": 0 }, "ring": null }
  },
  "subtitles": {
    "voice": "body",
    "weight": 700,
    "size": 52,
    "case": "uppercase",
    "tracking": 0.01,
    "colour": { "dark": "#111111", "light": "#111111" },
    "outline": null,
    "shadow": { "dark": null, "light": null },
    "backing": { "kind": "box", "dark": "#FFFFFF", "light": "#FFFFFF" },
    "key": { "voice": "display", "weight": 400, "style": "normal", "size": 54, "colour": "#111111", "box": { "colour": "hero", "radius": 8, "padX": 0.18, "padY": 0.06, "tilt": -3, "border": { "width": 4, "colour": "#111111" } } },
    "enter": "pop",
    "laneY": 1470,
    "words": [1, 3]
  },
  "composition": { "ground": "light", "align": "left", "margin": 84, "top": 220, "gap": { "eyebrow": 28, "tagline": 22, "object": 74 } },
  "presenter": {
    "layouts": { "full": true, "halfBand": true, "tile": true },
    "openOn": ["halfBand", "full"],
    "halfBand": { "feather": 0, "rule": { "width": 10, "colour": "#111111" } },
    "tile": { "radius": 24, "ring": { "width": 6, "colour": "#111111" }, "shadow": "16px 16px 0 #111111" },
    "rim": null
  },
  "transitions": {
    "cut": true,
    "ease": { "enabled": false, "dy": 40, "sink": 0.02, "frames": 8 },
    "zoomThrough": { "enabled": false, "frames": 5 },
    "flash": { "enabled": true, "colour": "hero", "frames": 2 },
    "whip": { "enabled": true, "frames": 8 }
  },
  "motion": {
    "reveal": { "bezier": [0.34, 1.56, 0.64, 1], "frames": 12, "stagger": 3 },
    "leave": [0.7, 0, 0.9, 0.2],
    "glide": [0.5, 0, 0.1, 1],
    "spring": { "w": 0.5, "z": 0.35 },
    "punch": { "amount": 0.12, "frames": 3 },
    "rise": 70
  },
  "pace": {
    "short": { "secondsPerChange": [1.5, 2.5], "punchIns": "every-line" },
    "long": { "secondsPerChange": [3.5, 5] },
    "endHoldMax": 1.5,
    "wordsPerMinute": [175, 215]
  },
  "scenes": {
    "brings": ["word-pop", "sticker"],
    "avoid": [],
    "beats": {
      "hook": { "use": ["sticker", "title", "talk:halfBand"] },
      "payoff": { "use": ["word-pop", "talk:full"] },
      "item": { "use": ["list"], "in": "whip" },
      "number": { "use": ["sticker", "stat"], "in": "flash" },
      "point": { "use": ["talk:full"] },
      "proof": { "use": ["quote"], "in": "whip" },
      "end": { "use": ["talk:full"] }
    }
  }
}
