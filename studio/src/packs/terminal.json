{
  "id": "terminal",
  "name": "Terminal",
  "description": "A code style: VT323 headlines and JetBrains Mono text in phosphor green on a CRT with scan lines, panels with corner marks, the key word inverted with a blinking cursor, pixel icons, the camera in a window, and type that arrives as if typed.",
  "fonts": [
    { "family": "VT323", "file": "fonts/terminal/VT323-Regular.woff2", "weight": "400" },
    { "family": "JetBrains Mono", "file": "fonts/shared/JetBrainsMono-400.woff2", "weight": "400" },
    { "family": "JetBrains Mono", "file": "fonts/shared/JetBrainsMono-700.woff2", "weight": "700" }
  ],
  "type": {
    "display": { "family": "VT323", "fallback": "monospace", "weight": 400, "style": "normal", "tracking": 0.02, "case": "uppercase", "metrics": "vt323", "layout": { "match": "cap", "fit": "cap", "fitScale": 1.3, "measure": 1, "lineHeight": 1.12 } },
    "accent": { "family": "JetBrains Mono", "fallback": "monospace", "weight": 400, "style": "normal", "tracking": -0.01, "case": "none", "metrics": "jetbrains-mono", "layout": { "match": "x", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } },
    "body": { "family": "JetBrains Mono", "fallback": "monospace", "weight": 400, "style": "normal", "tracking": -0.01, "case": "none", "metrics": "jetbrains-mono", "layout": { "match": "x", "fit": "width", "fitScale": 1, "measure": 34, "lineHeight": 2.6 } },
    "label": { "family": "JetBrains Mono", "fallback": "monospace", "weight": 700, "style": "normal", "tracking": 0.1, "case": "uppercase", "metrics": "jetbrains-mono", "layout": { "match": "cap", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } },
    "code": { "family": "JetBrains Mono", "fallback": "monospace", "weight": 400, "style": "normal", "tracking": 0, "case": "none", "metrics": "jetbrains-mono", "layout": { "match": "none", "fit": "width", "fitScale": 1, "measure": null, "lineHeight": null } }
  },
  "palette": {
    "base": "#050806",
    "panel": "#0B120E",
    "surface": "#101A14",
    "line": "#1C3A2A",
    "faint": "#2F5E45",
    "muted": "#4E8A68",
    "text": "#D4FFE3",
    "textSoft": "#7CD9A3",
    "ink": "#06100A",
    "inkSoft": "#2F5E45",
    "win": "#3DFF8F",
    "friction": "#FF5F56",
    "extended": { "amber": "#FFB000", "cyan": "#59F3FF", "magenta": "#FF4FD8" },
    "heroRotation": ["win", "amber", "cyan"]
  },
  "grounds": {
    "dark": { "colour": "#050806", "texture": null, "glows": [], "pattern": null, "vignette": null },
    "light": { "colour": "#E9F7EE", "texture": null, "glows": [], "pattern": null, "vignette": null }
  },
  "backdrops": [{ "kind": "scanlines", "size": 4, "alpha": 0.09, "glow": 0.14, "roll": 0.12 }],
  "signature": { "surface": "terminal", "mark": "invert", "icons": "pixel", "reveal": "type", "chrome": "window", "edge": "straight", "tilt": 0, "rough": 0, "boil": 0 },
  "cards": {
    "dark": { "top": "#07100B", "fill": "#07100B", "bottom": "#07100B", "up": "#0C1912", "up2": "#11231A", "radius": 0, "lightCatch": 0, "shadow": { "dx": 0, "dy": 0, "blur": 0, "colour": "#000000", "alpha": 0 }, "ring": { "width": 2, "colour": "#1F7A4A" } },
    "light": { "top": "#F4FBF6", "fill": "#F4FBF6", "bottom": "#F4FBF6", "up": "#E3F3E9", "up2": "#D2EADB", "radius": 0, "lightCatch": 0, "shadow": { "dx": 0, "dy": 0, "blur": 0, "colour": "#000000", "alpha": 0 }, "ring": { "width": 2, "colour": "#2F5E45" } }
  },
  "subtitles": {
    "voice": "body",
    "weight": 700,
    "size": 46,
    "case": "none",
    "tracking": -0.01,
    "colour": { "dark": "#D4FFE3", "light": "#06100A" },
    "outline": null,
    "shadow": { "dark": null, "light": null },
    "backing": { "kind": "block", "dark": "rgba(3,8,5,0.9)", "light": "rgba(233,247,238,0.94)" },
    "key": { "voice": "body", "weight": 700, "style": "normal", "size": 46, "colour": "#050806", "box": { "colour": "hero", "radius": 0, "padX": 0.18, "padY": 0.04, "tilt": 0 } },
    "enter": "type",
    "laneY": 1470,
    "words": [2, 5]
  },
  "composition": { "ground": "dark", "align": "left", "margin": 80, "top": 220, "gap": { "eyebrow": 26, "tagline": 22, "object": 64 } },
  "presenter": {
    "layouts": { "full": true, "halfBand": true, "tile": true },
    "openOn": ["halfBand"],
    "halfBand": { "feather": 0, "rule": { "width": 3, "colour": "hero" } },
    "tile": { "radius": 0, "ring": { "width": 2, "colour": "#1F7A4A" }, "shadow": "0 0 60px rgba(61,255,143,0.14)" },
    "rim": null
  },
  "transitions": {
    "cut": true,
    "ease": { "enabled": false, "dy": 24, "sink": 0.01, "frames": 8 },
    "zoomThrough": { "enabled": false, "frames": 4 },
    "flash": { "enabled": true, "colour": "hero", "frames": 2 },
    "glitch": { "enabled": true, "frames": 5 }
  },
  "motion": {
    "reveal": { "bezier": [0.2, 0.6, 0.35, 1], "frames": 14, "stagger": 5 },
    "leave": [0.7, 0, 0.9, 0.2],
    "glide": [0.5, 0, 0.2, 1],
    "spring": { "w": 0.55, "z": 0.9 },
    "punch": { "amount": 0.1, "frames": 1 },
    "rise": 0
  },
  "pace": {
    "short": { "secondsPerChange": [2, 2.5], "punchIns": "stressed-words" },
    "long": { "secondsPerChange": [4, 5] },
    "endHoldMax": 1.5,
    "wordsPerMinute": [170, 210]
  },
  "scenes": {
    "brings": ["word-pop", "command"],
    "avoid": [],
    "beats": {
      "hook": { "use": ["title", "talk:halfBand"] },
      "payoff": { "use": ["word-pop", "talk:full"] },
      "item": { "use": ["command", "list"], "in": "glitch" },
      "number": { "use": ["stat"], "in": "flash" },
      "point": { "use": ["talk:tile", "talk:full"] },
      "proof": { "use": ["quote"], "in": "glitch" },
      "end": { "use": ["talk:full"], "in": "glitch" }
    }
  }
}
