{
  "name": "yap-machine",
  "version": "0.1.0",
  "description": "The desk for Yap Machine: review your agent's cuts of your talking-head footage, leave notes, chat, and send it all back.",
  "type": "module",
  "license": "MIT",
  "author": "Red Morley Hewitt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamredmh/yap-machine.git"
  },
  "bin": {
    "yap-machine-desk": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "web-dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && vite build --config vite.preview.config.ts && npm run copy-licenses",
    "copy-licenses": "node scripts/copy-licenses.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.renderer-tests.json",
    "test": "vitest run",
    "desk": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.12.0",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.2.0",
    "@fontsource/geist-sans": "^5.2.0",
    "@types/node": "^22.10.0",
    "preact": "^10.29.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.0"
  }
}
